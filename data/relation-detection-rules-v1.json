        "question_blocks": 4,
        "subitems": 4,
        "status": "observed"
      },
      "representative_refs": [
        "2020 history Q5",
        "2022 history Q5",
        "2025 history Q5"
      ],
      "positive_examples": [
        "image_asset→entityName for any building with confirmed image"
      ],
      "negative_examples": [
