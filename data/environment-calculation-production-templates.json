{
  "ventilation_co2": {
    "id": "env_calc_ventilation_co2",
    "topic": "換気·CO2濃度",
    "formula": "Q = G / (Ci - Co)",
    "assumptions": [
      "定常状態",
      "完全混合",
      "室内CO2発生のみ"
    ],
    "parameterRanges": {
      "G": [
        0.01,
        0.025
      ],
      "Ci": [
        800,
        1500
      ],
      "Co": [
        300,
        600
      ]
    },
    "outputUnit": "m³/h",
    "reasoningSteps": 2
  },
  "thermal_transmission": {
    "id": "env_calc_thermal_transmission",
    "topic": "熱貫流率",
    "formula": "U = 1 / (1/ho + Σ(d/λ) + 1/hi)",
    "assumptions": [
      "定常状態",
      "一次元熱伝導",
      "接触抵抗無視"
    ],
    "parameterRanges": {
      "ho": [
        0.03,
        0.06
      ],
      "hi": [
        0.09,
        0.13
      ],
      "d1": [
        0.05,
        0.2
      ],
      "λ1": [
        0.03,
        0.06
      ],
      "d2": [
        0.1,
        0.2
      ],
      "λ2": [
        0.8,
        2.0
      ]
    },
    "outputUnit": "W/(m²·K)",
    "reasoningSteps": 3
  },
  "reverberation": {
    "id": "env_calc_reverberation",
    "topic": "残響時間",
    "formula": "T60 = 0.161 * V / A",
    "assumptions": [
      "拡散音場",
      "Sabineの残響式適用可能"
    ],
    "parameterRanges": {
      "V": [
        100,
        2000
      ],
      "A": [
        20,
        500
      ]
    },
    "outputUnit": "s",
    "reasoningSteps": 2
  },
  "illuminance_point": {
    "id": "env_calc_illuminance_point",
    "topic": "点光源の照度",
    "formula": "E = I * cosθ / r²",
    "assumptions": [
      "点光源",
      "直射光のみ（反射無視）"
    ],
    "parameterRanges": {
      "I": [
        200,
        2000
      ],
      "r": [
        1.0,
        5.0
      ],
      "θ": [
        0,
        60
      ]
    },
    "outputUnit": "lx",
    "reasoningSteps": 2
  },
  "dynamic_pressure": {
    "id": "env_calc_dynamic_pressure",
    "topic": "動圧",
    "formula": "q = ρ * v² / 2",
    "assumptions": [
      "非圧縮性流体",
      "定常流"
    ],
    "parameterRanges": {
      "ρ": [
        1.1,
        1.3
      ],
      "v": [
        2.0,
        15.0
      ]
    },
    "outputUnit": "Pa",
    "reasoningSteps": 2
  }
}